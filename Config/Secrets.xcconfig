// Build configuration secrets.
//
// Blank by default so CI (Xcode Cloud) and App Store builds work from a clean
// checkout. For local development, copy Secrets.xcconfig.example to
// Config/Secrets.local.xcconfig and fill in real values there — that file is
// gitignored, and the optional include below lets it override these defaults.

CAPOWHR_GITHUB_TOKEN =
STRAVA_CLIENT_ID =
STRAVA_CLIENT_SECRET =

#include? "Secrets.local.xcconfig"
