<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>WKBackgroundModes</key>
    <array>
        <string>workout-processing</string>
    </array>
    <key>CaPowHrGitHubToken</key>
    <string>$(CAPOWHR_GITHUB_TOKEN)</string>
    <key>StravaClientId</key>
    <string>$(STRAVA_CLIENT_ID)</string>
    <key>StravaClientSecret</key>
    <string>$(STRAVA_CLIENT_SECRET)</string>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.capowhr.strava-callback</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>capowhr</string>
            </array>
        </dict>
    </array>
</dict>
</plist>

